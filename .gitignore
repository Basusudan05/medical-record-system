# ── Dependencies ──────────────────────────────────────────────────────
node_modules/
.npm

# ── Environment variables — NEVER commit real keys ────────────────────
# .env.example files ARE committed (placeholders only, no real secrets)
.env
.env.local
.env.*.local

# ── Build output ──────────────────────────────────────────────────────
dist/
build/
.vite/

# ── Logs ──────────────────────────────────────────────────────────────
*.log
npm-debug.log*
yarn-debug.log*
yarn-error.log*
pnpm-debug.log*

# ── OS files ──────────────────────────────────────────────────────────
.DS_Store
Thumbs.db
desktop.ini

# ── IDE / Editor ──────────────────────────────────────────────────────
.vscode/
.idea/
*.suo
*.ntvs*
*.njsproj
*.sln

# ── Google Cloud service account keys — NEVER commit ──────────────────
*service-account*.json
*credentials*.json
google-cloud-*.json

# ── Coverage ──────────────────────────────────────────────────────────
coverage/

# ── Misc ──────────────────────────────────────────────────────────────
*.local
.cache/
